{
  "expo": {
    "name": "Kinetic",
    "slug": "kinetic-training",
    "scheme": "kinetic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.larenton.kinetic",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.larenton.kinetic",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Kinetic adds your planned training sessions to your calendar and shows what else is on that day."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Kinetic reads your steps, active energy, workouts and body weight to show your progress in and out of the gym.",
          "NSHealthUpdateUsageDescription": "Kinetic saves the workouts, nutrition and body weight you log to Apple Health.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
